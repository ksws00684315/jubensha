    {
      "id": "chenjie",
      "name": "陈捷",
      "gender": "女",
      "age": 32,
      "publicProfile": {
        "identity": "沈万钧的女儿",
        "bio": [
          {
            "type": "paragraph",
            "text": "沈万钧与前妻所生的女儿，幼年随母亲离开，近年才与父亲相认。沈万钧对她很好，带她参加各种社交场合。这次晚宴是她第一次上游艇。"
          }
        ],
        "relationships": [
          { "characterId": "fangmin", "label": "父亲的医生" }
        ]
      },
      "privateCard": {
        "backstory": [
          {
            "type": "paragraph",
            "text": "你六岁那年，妈妈带你离开了'家'。她说爸爸去了很远的地方。十八岁那年，你在阁楼找到了一个铁盒子，里面是你亲生父亲陈正邦的日记。最后一页写着：'沈万钧吞了我的公司，我走投无路了。小捷，爸爸对不起你。'第二天，陈正邦跳楼自杀。你查了十年，终于确认：远洋贸易的前身就是你父亲的公司。沈万钧用一份伪造的合同吞并了它。你改了姓，整了容，花了三年接近沈万钧，成了他的'女儿'。一周前，沈万钧拿着一份DNA报告看着你，说：'你不是我女儿。'你知道，你的机会不多了。"
          }
        ],
        "secrets": [
          {
            "id": "secret_chen_1",
            "title": "真实身份",
            "content": [
              {
                "type": "paragraph",
                "text": "你不是沈万钧的亲生女儿。你是陈正邦的女儿——被沈万钧逼死的那个人的女儿。你改姓、整容、伪造身份，花了三年成为他的'女儿'。"
              }
            ],
            "disclosure": "never"
          },
          {
            "id": "secret_chen_2",
            "title": "DNA报告",
            "content": [
              {
                "type": "paragraph",
                "text": "沈万钧一周前拿到了DNA报告，知道你不是亲生的。他当时说要'重新安排一切'。"
              }
            ],
            "disclosure": "conditional",
            "condition": "如果有人提到DNA报告或沈万钧发现了什么"
          }
        ],
        "objectives": [
          {
            "id": "obj_chen_1",
            "title": "隐藏身份",
            "content": [
              {
                "type": "paragraph",
                "text": "不要让任何人知道你是陈正邦的女儿。如果这个秘密暴露，你的杀人动机就暴露了。"
              }
            ],
            "priority": "primary"
          },
          {
