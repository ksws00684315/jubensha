  "characters": [
    {
      "id": "zhouming",
      "name": "周铭",
      "gender": "男",
      "age": 52,
      "publicProfile": {
        "identity": "远洋贸易集团副董事长",
        "bio": [
          {
            "type": "paragraph",
            "text": "沈万钧的多年合伙人，持有集团30%股份。近年来两人在公司发展方向上分歧越来越大，最近一次董事会上，沈万钧提出稀释周铭的股份，两人当场翻脸。"
          }
        ],
        "relationships": [
          { "characterId": "liwei", "label": "下属" }
        ]
      },
      "privateCard": {
        "backstory": [
          {
            "type": "paragraph",
            "text": "你和沈万钧二十年前一起创办远洋贸易。五年前你儿子查出白血病，你卖了房子、借了高利贷，医药费像个无底洞。你开始从公司账上借钱——不是贪污，是借。沈万钧发现了，没有报警，但条件是：你的股份逐步转让给他。你恨他趁火打劫，但你更需要钱。上周你听说他准备在新遗嘱里彻底把你踢出去。"
          }
        ],
        "secrets": [
