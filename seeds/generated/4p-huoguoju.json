    {
      "id": "a_liang",
      "name": "阿亮",
      "gender": "男",
      "age": 22,
      "publicProfile": {
        "bio": [
          {
            "type": "paragraph",
            "text": "店里小工，全能打杂，梦想当美食主播，账号阿亮涮一切刚满两千粉。"
          }
        ],
        "relationships": []
      },
      "privateCard": {
        "backstory": [
          {
            "type": "paragraph",
            "text": "你叫李良，大家喊你阿亮。你在曹姐店里干了一年，白天切肉晚上洗碗，收工后偷偷用后厨的牛油和毛肚拍深夜食堂短视频——曹姐发现一次骂一次：生肉上镜，检查的来了我替你哭？昨晚你把手机架在茶水间窗台上录打烊实况，人跑去后厨倒垃圾。今晚雷师傅出事前后，你的手机一直开着——你后来翻素材才发现，22:09 那段拍到了不该拍的东西。你现在慌两件事：凶手是谁，和生肉上镜第四回被逮住。"
          }
        ],
        "secrets": [
          {
            "id": "secret_a_liang_1",
            "title": "核心秘密",
            "content": [
              {
                "type": "paragraph",
                "text": "你长期偷用后厨食材拍吃播；案发时段你人在后厨，手机在窗台录着大堂——素材里拍到了老周往盐罐里倒东西，但交出手机等于自曝违规，你攥着这支铁证不敢撒手。"
              }
            ],
            "disclosure": "never"
          }
        ],
        "objectives": [
          {
            "id": "objective_a_liang_1",
            "title": "本局目标",
            "content": [
              {
                "type": "paragraph",
                "text": "让素材在不暴露生肉镜头的前提下成为破案关键；实在瞒不住就交素材，但要抢先自罚三杯毛肚汤表忠心，把违规说成不懂事。"
              }
            ],
            "priority": "primary"
          }
