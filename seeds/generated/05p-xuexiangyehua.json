        "relationships": []
      },
      "privateCard": {
        "backstory": [
          {
            "type": "paragraph",
            "text": "你叫崔九安，村兽医。白守业后院的老界树压着你家药材地二十年，前天他砍了两棵，你上门被骂了回来。昨晚 21:00 你又去摔了一回门，全院听见你喊'这事没完'；21:30 你回屋早睡——你耳背，夜里什么都没听见。今早你蹲在遗体边只看一眼就皱眉：冻死的人有冻死的死相，而他有四个'不对'。"
          }
        ],
        "secrets": [
          {
            "id": "secret_cuijiuan_1",
            "title": "核心秘密",
            "content": [
              {
                "type": "paragraph",
                "text": "你与死者有二十年界树积怨，昨晚 21:00 你摔门叫阵'这事没完'，全院听见——你是案发前最后一个跟他红过脸的外人。你还有件私事：砍树前你在界树桩里埋过一截地界铁桩，'证据'在你手里，你怕验尸验出你也怕翻树桩翻出你。"
              }
            ],
            "disclosure": "never"
