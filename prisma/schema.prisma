generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 剧本。content 为 V2 剧本文档（结构见 src/core/script/v2/schema.ts），元数据列用于列表查询。
model Script {
  id          String   @id @default(cuid())
  title       String
  minPlayers  Int
  maxPlayers  Int
  durationMin Int
  difficulty  String // 新手 | 进阶 | 硬核
  tags        String[]
  intro       String
  content     Json
  /// 作者设计包与正文分离，允许在导入 V2 前持续审稿。
  designPackage Json?
  designHash  String?
  designReview Json?
  source      String   @default("manual") // manual | ai | import
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  games Game[]

  @@map("scripts")
}

/// AI 接入方。protocol: openai_compatible | anthropic
model AiProvider {
  id           String   @id @default(cuid())
  name         String
  protocol     String   @default("openai_compatible")
  baseUrl      String
  apiKeyCipher String // AES-GCM 密文（master key 来自 .env）
  enabled      Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bindings  ModelBinding[]
  usageLogs UsageLog[]

  @@map("ai_providers")
}

/// 用途绑定：一个 slot 绑定某 provider 的某 model。
/// slot: dm | culprit | player | generator | tts
/// fallbackSlot: 主调用失败时降级到的同表 slot 名（纯字符串，运行时解析）
model ModelBinding {
  id           String  @id @default(cuid())
  slot         String  @unique
  providerId   String
  modelId      String // provider 侧的模型标识，如 deepseek-chat
  temperature  Float?
  maxTokens    Int? // 单次最大输出 token（含思考）；空则用运行时默认 32768。不是上下文窗口。
  contextWindow Int? // 输入上下文窗口；空表示未配置，不得由运行时猜测
  supportsSystem Boolean @default(true)
  supportsJson Boolean @default(false)
  fallbackSlot String?

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("model_bindings")
}

/// 游戏房间。真人凭 code + 座位 token 加入。
model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  scriptId  String
  status    String   @default("lobby") // lobby | playing | ended | aborted
  humanDm              Boolean  @default(false) // 开启后由真人担任 DM
  unlimitedHumanTurns  Boolean  @default(true) // 真人发言/搜证/投票不限时；关闭则 3 分钟后自动跳过
  dmToken              String? // 真人 DM 的身份凭证
  dmName               String?
  hostToken            String? // 创建者凭证，大厅改座位 / 开局需要
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats Seat[]
  game  Game?

  @@map("rooms")
}

/// 座位。kind: human | ai | empty
model Seat {
  id          String  @id @default(cuid())
  roomId      String
  index       Int
  kind        String
  playerName  String? // 真人昵称 / AI 显示名
  characterId String? // 绑定的剧本角色
  token       String? // 真人座位的轻量身份凭证
  ready       Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, index])
  @@map("seats")
}

/// 一局对局。state 为引擎快照（座位运行时状态、线索状态等）——恢复以快照为权威；
/// 事件流用于现场回放展示与审计，不做完整状态重放（技能/答题/限时等不参与重建）。
model Game {
  id        String    @id @default(cuid())
  roomId    String    @unique
  scriptId  String
  status    String    @default("running") // running | ended | aborted
  phase     String    @default("LOBBY")
  round     Int       @default(0)
  state     Json      @default("{}")
  /// 开局时规范化的剧本快照；对局恢复不得读取后续被编辑的 Script.content。
  scriptSnapshot       Json?
  scriptHash           String?
  scriptSnapshotSource String?  // start | legacy_baseline
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  events       GameEvent[]
  seatStates   SeatState[]
  votes        Vote[]
  privateChats PrivateMessage[]

  room  Room  @relation(fields: [roomId], references: [id])
  script Script @relation(fields: [scriptId], references: [id])

  @@map("games")
}

/// 对局事件流（append-only，事件溯源）。seq 为全局递增序号，SSE 按 seq 续传。
/// visibility: public | seat:<n> | dm
model GameEvent {
  seq        BigInt   @id @default(autoincrement())
  gameId     String
  type       String // phase | speech | system | clue | vote | private | reveal
  phase      String
  round      Int      @default(0)
  fromSeat   Int? // null = 系统 / DM
  toSeat     Int? // 定向（私聊对象）
  visibility String   @default("public")
  content    Json // { text, ...meta }
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, seq])
  @@map("game_events")
}

/// 每局每座的私有状态：持有的线索、已读标记等。
model SeatState {
  id        String @id @default(cuid())
  gameId    String
  seatIndex Int
  data      Json   @default("{}") // { clueIds: string[], readScript: boolean, ... }

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seatIndex])
  @@map("seat_states")
}

model Vote {
  id          String   @id @default(cuid())
  gameId      String
  seatIndex   Int
  targetIndex Int
  reason      String?
  createdAt   DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seatIndex])
  @@map("votes")
}

/// 私聊消息。仅双方可见（seat_private）。
model PrivateMessage {
  seq        BigInt   @id @default(autoincrement())
  gameId     String
  fromSeat   Int
  toSeat     Int
  content    String
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, seq])
  @@map("private_messages")
}

/// 向量检索记忆层：公开发言的 embedding 缓存（仅当设置页绑定 embedding 模型后写入）。
model EventVector {
  gameId String
  seq    BigInt
  vector Json
  /// embedding 空间标识，避免不同模型/端点的同维向量混用。
  spaceId String @default("legacy")
  dimension Int @default(0)
  sourceHash String?

  @@id([gameId, seq])
  @@index([gameId, spaceId])
  @@map("event_vectors")
}

/// LLM/TTS 调用记账。
model UsageLog {
  id               String   @id @default(cuid())
  providerId       String?
  providerName     String
  modelId          String
  purpose          String // dm | culprit | player | generator | tts
  gameId           String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cachedTokens     Int      @default(0) // 输入里命中前缀缓存的 token
  totalTokens      Int      @default(0)
  latencyMs        Int?
  ok               Boolean  @default(true)
  error            String?
  /// 贯穿一次逻辑调用（包括重试和 fallback）的请求标识。
  requestId        String?
  /// 引擎生成代次；阶段切换后可据此识别迟到输出。
  generationId     String?
  /// 细分任务类型，如 speech、question、review、plan。
  taskType         String?
  /// 调用前按消息文本估算的输入 token 数。
  inputTokensEstimate Int?
  /// 本次编排允许的输入预算（不含输出和安全余量）。
  budgetTokens     Int?
  /// 在本条日志前已经发生的重试次数。
  retryCount       Int @default(0)
  /// 请求由 AbortController 取消，而非模型返回错误。
  cancelled        Boolean @default(false)
  createdAt        DateTime @default(now())

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("usage_logs")
  @@index([createdAt])
  @@index([gameId])
}

/// TTS 合成缓存，按 文本+音色+provider 哈希去重。
model TtsCache {
  id        String   @id @default(cuid())
  hash      String   @unique
  provider  String
  voice     String
  filePath  String
  createdAt DateTime @default(now())

  @@map("tts_cache")
}
