# 可被「设置 → 数据库」写入的 local.app.json 覆盖
DATABASE_URL="postgresql://postgres:jubensha@localhost:5432/jubensha?schema=public"
# 加密 AI Provider apiKey 的主密钥（32+ 位随机串，生产环境务必更换）。
# 生成方式：openssl rand -base64 36
# 轮换会使已存的 provider apiKey 密文不可解，需到「设置 → AI 接入」重填。
SECRET_MASTER_KEY="change-me"
# 生产环境必填，且必须与 SECRET_MASTER_KEY 不同。本机开发环境 localhost 访问无需口令。
# ADMIN_TOKEN="your-admin-token"
# 可选。管理会话 cookie 的签名密钥；不设则回落到 SECRET_MASTER_KEY（兼容旧部署）。
# 建议独立设置，避免「主密钥泄露」同时等于「管理会话可离线伪造」。
# ADMIN_SESSION_SECRET="another-random-secret"

# ⚠️ 不要使用 ADMIN_TRUST_LOOPBACK：它让 "Host: localhost" 的请求免口令进入管理面，
# 而 Host 头完全由客户端控制——next start 监听所有接口时，局域网内任意主机即可利用。
# 若确实需要，必须同时把服务绑到本机（ecosystem.config.js 里 HOSTNAME=127.0.0.1）并只经反代对外，
# 否则请改用 ADMIN_TOKEN 凭证门。引擎会在该开关生效时打印一条警告日志。

# LLM provider baseUrl 的 SSRF 守卫策略。默认放行回环/私网（Ollama、LM Studio 等本地推理依赖它们），
# 云元数据/链路本地段（169.254.*、fe80::、*.internal）任何配置下都封禁。
# 纯云端 provider 部署可收紧为 0，连本地/内网地址一并拒绝。
# ALLOW_PRIVATE_PROVIDER_URL=0

# 开房授权策略：AI 座位会真实调用 LLM 并按 token 计费，用它限制「谁能开这种局」。
#   open   —— 任何人可创建含 AI 座位的房间（开发环境默认）
#   admin  —— 需管理员身份：带 ADMIN_TOKEN 口令、管理会话 cookie，或本机免登录（生产环境默认）
#   invite —— 需请求体带 inviteCode，与 ROOM_INVITE_CODE 常量时间比对
# 只影响含 AI 座位的房间与「把座位改成 AI」的 PATCH；纯真人房始终自由创建。
# ROOM_CREATE_POLICY=admin
# invite 模式的邀请码（随机串，例如 `openssl rand -hex 12` 的输出）。
# 未配置时该模式一律拒绝创建含 AI 座位的房间（宁可开不了局，也不等于向所有人开放）。
# 目前开黑页尚无邀请码输入框，invite 供接口级/脚本化开通使用。
# ROOM_INVITE_CODE=""

# 每日 LLM token 预算（熔断）：服务器本地时区一天内 usage_logs.totalTokens 合计达到该值后，
# chat / chatStream 直接抛错、embedding 停用，AI 发言降级为提示语 —— 对局不卡住，真人仍可继续。
# 用量在「设置 → 用量」页可见。0 或不设置 = 关闭熔断（现有部署的行为不变）。
# LLM_DAILY_TOKEN_BUDGET=2000000


# 测试隔离：设置后配置读写指向该文件，而不是 cwd 下的 local.app.json（见 src/lib/app-config.ts）。
# e2e 实例与集成测试用它避免误读本机开发配置。
# APP_CONFIG_PATH="./.e2e/app.json"
